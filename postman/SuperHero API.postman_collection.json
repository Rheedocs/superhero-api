      "name": "GET alle helte (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Metode er GET', function () { pm.expect(pm.request.method).to.eql('GET'); });",
              "pm.test('Status er 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Array med mindst et element', function () { const d = pm.response.json(); pm.expect(d).to.be.an('array'); pm.expect(d.length).to.be.above(0); });",
              "pm.test('Foerste helt har de rigtige felter', function () { pm.expect(pm.response.json()[0]).to.include.all.keys('id', 'name', 'fullName', 'strength', 'image'); });"
            ]
          }
